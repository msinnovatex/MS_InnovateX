{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?__msix_path=:path*"
    },
    {
      "source": "/((?!api/|admin/|adofferint/|assets/).*)",
      "destination": "/index.html"
    }
  ]
}
